<base:WpfUiWindow
    x:Class="Bloxstrap.UI.Elements.Dialogs.AddAccountDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:resources="clr-namespace:Bloxstrap.Resources"
    Title="{x:Static resources:Strings.Accounts_Add}"
    Width="560"
    MinWidth="0"
    MinHeight="0"
    SizeToContent="Height"
    ResizeMode="NoResize"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <base:WpfUiWindow.Resources>
        <Style x:Key="OptionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </base:WpfUiWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Padding="8"
            CanMaximize="False"
            ShowMaximize="False"
            ShowMinimize="False"
            ShowClose="True"
            KeyboardNavigation.TabNavigation="None" />

        <StackPanel Grid.Row="1" Margin="24,4,24,22">
            <DockPanel Margin="0,0,0,20">
                <Border
                    Width="46"
                    Height="46"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                    BorderThickness="1.5"
                    CornerRadius="23">
                    <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="22"
                        Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                        Symbol="Person24" />
                </Border>
                <TextBlock
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="{x:Static resources:Strings.Accounts_Add}"
                    TextWrapping="Wrap" />
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="RobloxWindowCard"
                    Grid.Column="0"
                    Margin="0,0,6,0"
                    MouseLeftButtonUp="OnRobloxWindowCardClicked"
                    Style="{StaticResource OptionCard}">
                    <StackPanel>
                        <Border
                            Width="52"
                            Height="52"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                            BorderThickness="1.5"
                            CornerRadius="26">
                            <ui:SymbolIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="24"
                                Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                Symbol="Person24" />
                        </Border>
                        <TextBlock
                            Margin="0,14,0,2"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="{x:Static resources:Strings.Accounts_RobloxWindow}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{x:Static resources:Strings.Accounts_LoginOrCreate}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="CookieCard"
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    MouseLeftButtonUp="OnCookieCardClicked"
                    Style="{StaticResource OptionCard}">
                    <StackPanel>
                        <Border
                            Width="52"
                            Height="52"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                            BorderThickness="1.5"
                            CornerRadius="26">
                            <ui:SymbolIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="24"
                                Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                Symbol="Key24" />
                        </Border>
                        <TextBlock
                            Margin="0,14,0,2"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="{x:Static resources:Strings.Accounts_Cookie}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{x:Static resources:Strings.Accounts_PasteCookie}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel
                x:Name="CookiePanel"
                Margin="0,16,0,0"
                Visibility="Collapsed">
                <TextBlock
                    FontSize="13"
                    FontWeight="Medium"
                    Text="{x:Static resources:Strings.Accounts_AccountCookie}" />
                <Grid Margin="0,6,0,0">
                    <TextBox
                        x:Name="CookieTextBox"
                        Height="68"
                        Padding="8,6"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        FlowDirection="LeftToRight"
                        FontSize="12"
                        TextChanged="OnCookieTextChanged"
                        TextWrapping="Wrap"
                        VerticalAlignment="Stretch"
                        VerticalScrollBarVisibility="Auto" />
                    <TextBlock
                        x:Name="CookiePlaceholder"
                        Margin="11,8,0,0"
                        VerticalAlignment="Top"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        IsHitTestVisible="False"
                        Text="{x:Static resources:Strings.Accounts_CookiePlaceholder}"
                        TextWrapping="Wrap" />
                </Grid>
                <TextBlock
                    x:Name="CookieErrorText"
                    Margin="0,6,0,0"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <StackPanel
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <ui:Button
                        Content="{x:Static resources:Strings.Common_Cancel}"
                        Click="OnCancelClicked" />
                    <ui:Button
                        x:Name="AddCookieButton"
                        Margin="8,0,0,0"
                        Appearance="Primary"
                        Click="OnAddCookieClicked"
                        Content="{x:Static resources:Strings.Common_AddSingle}" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                x:Name="RobloxWindowPanel"
                Margin="0,16,0,0"
                Visibility="Collapsed">
                <DockPanel>
                    <ui:ProgressRing
                        x:Name="WindowProgress"
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        IsIndeterminate="True" />
                    <TextBlock
                        x:Name="RobloxWindowStatus"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="{x:Static resources:Strings.Accounts_Starting}"
                        TextWrapping="Wrap" />
                </DockPanel>
                <StackPanel
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <ui:Button
                        Content="{x:Static resources:Strings.Common_Cancel}"
                        Click="OnCancelWindowClicked" />
                </StackPanel>
            </StackPanel>

            <TextBlock
                Margin="0,18,0,0"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{x:Static resources:Strings.Accounts_SecurityNote}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</base:WpfUiWindow>
