<base:WpfUiWindow
    x:Class="Bloxstrap.UI.Elements.Dialogs.AccountsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:resources="clr-namespace:Bloxstrap.Resources"
    Title="{x:Static resources:Strings.Accounts_Title}"
    Width="620"
    MinWidth="0"
    MinHeight="0"
    SizeToContent="Height"
    ResizeMode="NoResize"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <base:WpfUiWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </base:WpfUiWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Padding="8"
            CanMaximize="False"
            ShowMaximize="False"
            ShowMinimize="False"
            Title="{x:Static resources:Strings.Accounts_Title}"
            KeyboardNavigation.TabNavigation="None" />

        <StackPanel Grid.Row="1" Margin="24,8,24,18">
            <TextBlock
                FontSize="24"
                FontWeight="Medium"
                Text="{x:Static resources:Strings.Accounts_Title}" />
            <TextBlock
                Margin="0,4,0,0"
                FontSize="14"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{x:Static resources:Strings.Accounts_Description}"
                TextWrapping="Wrap" />

            <ScrollViewer
                x:Name="AccountListScroller"
                MaxHeight="340"
                Margin="0,10,0,0"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AccountList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,8"
                                Padding="14"
                                Cursor="Hand"
                                MouseLeftButtonUp="OnAccountClicked">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid
                                        Grid.Column="0"
                                        Width="40"
                                        Height="40">
                                        <Border
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="20">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="15"
                                                Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                                Text="{Binding Initial}" />
                                        </Border>
                                        <Ellipse
                                            Width="40"
                                            Height="40"
                                            Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}}">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>

                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="14,0,8,0"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="14"
                                            Text="{Binding DisplayName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding Tag}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <ui:SymbolIcon
                                        Grid.Column="2"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                        Symbol="Checkmark24"
                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />

                                    <ui:Button
                                        Grid.Column="3"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Click="OnLaunchAccountClicked"
                                        Content="{x:Static resources:Strings.Accounts_Launch}"
                                        Icon="Play24"
                                        ToolTip="{x:Static resources:Strings.Accounts_LaunchTooltip}" />

                                    <ui:Button
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        Click="OnDeleteAccountClicked"
                                        Icon="Delete24"
                                        ToolTip="{x:Static resources:Strings.Accounts_Delete}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border
                x:Name="EmptyState"
                Margin="0,10,0,0"
                Padding="24"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                Visibility="Collapsed">
                <StackPanel>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="Medium"
                        Text="{x:Static resources:Strings.Accounts_Empty}"
                        TextWrapping="Wrap"
                        TextAlignment="Center" />
                    <TextBlock
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{x:Static resources:Strings.Accounts_EmptyDescription}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border
            Grid.Row="2"
            Padding="24,14"
            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
            <WrapPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    MinWidth="150"
                    Appearance="Primary"
                    Click="OnAddAccountClicked"
                    Content="{x:Static resources:Strings.Accounts_Add}"
                    Icon="Add24" />
                <ui:Button
                    MinWidth="100"
                    Margin="8,0,0,0"
                    Click="OnCloseClicked"
                    Content="{x:Static resources:Strings.Common_Close}" />
            </WrapPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
